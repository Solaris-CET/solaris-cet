# Coolify / production runtime — set in UI (Runtime secrets, NOT build args)

VITE_PUBLIC_SITE_URL=https://solaris-cet.com
SENTRY_ENVIRONMENT=production

# Platform DB (Coolify postgres service)
DATABASE_URL=postgresql://solaris:CHANGE_ME@postgres:5432/solaris_cet
POSTGRES_PASSWORD=CHANGE_ME

# Auth / admin
JWT_SECRET=CHANGE_ME
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME

# Survey engine bridge (internal Docker network)
SURVEY_ENGINE_URL=http://survey-engine:8000
LEAD_STORAGE_DIR=/data/leads
SURVEY_COST_BUDGET_USD=15

# Optional: Telegram alert on new survey CRM lead
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# Survey AI keys (survey-engine service)
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=moonshot-v1-8k-vision-preview
XAI_API_KEY=

# Faza 10 — installer SaaS keys + rate limit (survey-engine)
INSTALLER_API_KEYS={"INST-1":"CHANGE_ME"}
SURVEY_RATE_LIMIT_PER_HOUR=60

# Faza 9 — webhook on CRM lead (Node frontend)
SURVEY_WEBHOOK_URL=
SURVEY_WEBHOOK_SECRET=

# Post-deploy gate (Coolify hook / manual)
POST_DEPLOY_BASE_URL=https://solaris-cet.com
POST_DEPLOY_SURVEY_GATE=1
SOFT_FAIL=1

# Coolify API redeploy (scripts/coolify-redeploy-survey.mjs)
COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=
COOLIFY_RESOURCE_UUID=
COOLIFY_TAG=main

# TON / AI platform (existing)
TONCENTER_RPC_URL=https://toncenter.com/api/v2/jsonRPC
ENCRYPTION_SECRET=