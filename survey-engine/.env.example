# SOLARIS CET — API Keys (copiază în .env, nu comite .env în git)

# DeepSeek V4 Pro — vision + extracție (default ≤6 poze)
DEEPSEEK_API_KEY=

# Moonshot Kimi — long-context + multi-image (10+ poze)
KIMI_API_KEY=

# Anthropic Claude — Sonnet 5 (premium rutină) + Fable 5 (top-tier)
ANTHROPIC_API_KEY=

# xAI Grok — orchestrare + review (opțional)
XAI_API_KEY=

# Soft Cost ROI (admin dashboard — L-SOFT-ROI)
SURVEY_BASELINE_MINUTES=60
SURVEY_TARGET_MINUTES=20
INSTALLER_HOURLY_RATE_EUR=35
SOFT_COST_USD_PER_W=0.17
EUR_USD_RATE=0.92

# Installer SaaS API keys — JSON map installer_id → secret (header X-Installer-Key)
# INSTALLER_API_KEYS={"INST-1":"your-secret-key","INST-2":"another-secret"}
INSTALLER_API_KEYS=