{
  "name": "solaris-cet-root",
  "private": true,
  "packageManager": "npm@10.8.1",
  "workspaces": [
    "app",
    "api",
    "cli",
    "contracts",
    "scripts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app:dev": "npm --workspace=app run dev --",
    "api:dev": "npm run api:build --workspace=app && npm run start:node --workspace=app",
    "dev:local": "node scripts/dev-local.mjs",
    "stash:prime": "node scripts/stash-prime.mjs",
    "stash:sync": "node scripts/stash-sync.mjs",
    "stash:verify": "node scripts/stash-verify.mjs",
    "loops:next": "node scripts/loops-next-task.mjs",
    "loops:status": "node scripts/loops-status.mjs",
    "loops:refine": "node scripts/deepseek-refine.mjs",
    "aider": "node scripts/aider-run.mjs",
    "app:build": "npm run build --workspace=app && npm run api:build --workspace=app",
    "app:build:next": "npm run build --workspace=app",
    "app:verify": "npm run verify --workspace=app",
    "engine:start": "cd engine && ./farming-engine",
    "survey:api": "cd survey-engine && python -m uvicorn src.server:app --reload --port 8000",
    "survey:test": "cd survey-engine && python -m pytest tests/ -q",
    "survey:demo": "cd survey-engine && python -m src.cli demo",
    "survey:web": "cd survey-engine && python -m src.cli web",
    "survey:smoke": "node scripts/survey-smoke.mjs",
    "survey:post-deploy": "node scripts/post-deploy-survey.mjs",
    "survey:prod-gate": "node scripts/survey-prod-gate.mjs",
    "survey:bridge-smoke": "node scripts/survey-bridge-smoke.mjs",
    "deploy:status": "node scripts/deploy-status.mjs",
    "deploy:p0": "node scripts/p0-deploy.mjs",
    "coolify:redeploy-survey": "node scripts/coolify-redeploy-survey.mjs",
    "gitea:push-retry": "node scripts/gitea-push-retry.mjs",
    "survey:deploy": "node scripts/deploy-survey-stack.mjs",
    "gitea:push": "node scripts/gitea-push-main.mjs",
    "survey:deploy:smoke": "node scripts/deploy-survey-stack.mjs --smoke-only",
    "stack:survey": "docker compose -f docker/docker-compose.survey.yml up --build",
    "stack:survey:down": "docker compose -f docker/docker-compose.survey.yml down",
    "ci:install": "node scripts/ci-install.mjs",
    "ci:win": "node scripts/ci-install.mjs",
    "app:test:e2e": "npm run test:e2e --workspace=app",
    "app:test:e2e:stable": "PW_WORKERS=1 npm run test:e2e --workspace=app",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "api:typecheck": "npm run typecheck --workspace=api",
    "cli:build": "npm run build --workspace=cli",
    "cli:typecheck": "npm run typecheck --workspace=cli",
    "contracts:test": "npm test --workspace=contracts",
    "contracts:typecheck": "npx tsc --noEmit -p contracts/tsconfig.json",
    "scripts:typecheck": "npm run typecheck --workspace=scripts",
    "licenses:prod": "node scripts/generate-third-party-licenses.mjs",
    "licenses:all": "node scripts/generate-third-party-licenses.mjs --all",
    "lighthouse:audit": "node scripts/lighthouse-audit.mjs",
    "uptime:heartbeat": "node scripts/uptime-heartbeat.mjs",
    "verify:fast": "npm run audit:prod && npm run api:typecheck && npm run cli:typecheck && npm run scripts:typecheck && npm run contracts:test && npm run contracts:typecheck && npm run survey:test && npm run app:verify",
    "verify:all": "npm run verify:fast && npm run app:test:e2e:stable",
    "gen:agent:5000": "node scripts/generate-agent-5000.mjs --count=5000",
    "gen:component": "plop component",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "dependencies": {
    "@walletconnect/ethereum-provider": "^2.23.9",
    "react-helmet-async": "^3.0.0",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "three": "^0.184.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.60.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "css-tree": "^3.2.1",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "plop": "^4.0.1",
    "typescript": "6.0.3",
    "vite": "8.0.11",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "app/**/*.{ts,tsx,js,jsx}": [
      "npx eslint --config app/eslint.config.js --fix"
    ]
  },
  "overrides": {
    "axios": "1.16.1",
    "lodash-es": "4.18.1",
    "esbuild": "0.27.7",
    "protobufjs": "7.6.1",
    "uuid": "14.0.0",
    "d3-color": "3.1.0",
    "dompurify": "3.4.5",
    "gaxios": "7.1.2",
    "gcp-metadata": "8.1.2",
    "mermaid": "11.14.0",
    "ox": "0.14.22",
    "typescript": "6.0.3",
    "viem": "2.50.4",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.27.7"
    },
    "langium": "4.2.2",
    "workbox-build": {
      "@rollup/plugin-terser": "1.0.0"
    },
    "@rollup/plugin-terser": {
      "serialize-javascript": "7.0.5"
    }
  }
}
