{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "strict": true,
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": [
    "vitest.setup.ts",
    "src/__tests__/**/*.ts",
    "src/__tests__/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/types/**/*.d.ts"
  ],
  "exclude": []
}
